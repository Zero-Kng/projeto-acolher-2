# Cabecalhos de seguranca (equivalente ao netlify.toml da versao Netlify,
# adaptado para hospedagem Apache/KingHost)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Paginas consolidadas: Cultura entrou em Educacao e Cultura, Familias entrou
# em Convivencia e Atendimento Familiar. Redireciona para nao quebrar link ja
# compartilhado nem URL que o Google indexou pelo sitemap antigo.
<IfModule mod_alias.c>
  Redirect 301 /atividades-cultura.html /atividades-educacao.html
  Redirect 301 /atividades-familias.html /atividades-convivencia.html
</IfModule>

# Pagina de erro 404 customizada
ErrorDocument 404 /404.html

# Forca HTTPS assim que o certificado SSL gratuito da KingHost estiver ativo
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
